package views

import (
	"playword/internal/adapters/index/rhymeindex"
	"playword/internal/app"
	"playword/internal/domain/entry"
)

// WordHeader names a word and what it rhymes on, with the main action.
templ WordHeader(e *rhymeindex.Entry, level string, page bool) {
	<header class="word-head">
		if page {
			<h1 class="hw">{ e.Headword }</h1>
		} else {
			<h2 class="hw" id="panel-title">{ e.Headword }</h2>
		}
		if parts := rimeInfo(e); len(parts) > 0 {
			<p class="rime">
				Vần
				for i, r := range parts {
					if i > 0 {
						<span class="muted">·</span>
					}
					<b>{ r.Rime }</b> <span class="tone">{ r.Tone }</span>
				}
			</p>
		}
		if level != "" {
			<p class="muted small">Mức khớp: { level }</p>
		}
	</header>
}

// Definition is a word's meanings; long lists fold after three.
templ Definition(e *rhymeindex.Entry) {
	<div class="defbody">
		<ol class="senses">
			for _, s := range headSenses(e) {
				@sense(s)
			}
		</ol>
		if more := moreSenses(e); len(more) > 0 {
			<details class="more-senses">
				<summary>Xem thêm { itoa(len(more)) } nghĩa</summary>
				<ol class="senses" start={ itoa(sensesShown + 1) }>
					for _, s := range more {
						@sense(s)
					}
				</ol>
			</details>
		}
		<p class="meta">
			Nguồn: { e.Source }
			if e.Confidence > 0 && e.Confidence < 1 {
				· <span title="Phát âm suy ra từ gốc từ">phát âm suy ra</span>
			}
		</p>
	</div>
}

templ sense(s entry.Sense) {
	<li>
		if s.POS != "" {
			<span class="pos">{ s.POS }</span>
		}
		{ s.Gloss }
		for _, ex := range s.Examples {
			<span class="ex">{ ex }</span>
		}
	</li>
}

// wordActions are the next steps from a word.
templ wordActions(e *rhymeindex.Entry, dict bool) {
	<p class="actions">
		if !e.RhymeError {
			<a class="btn primary" href={ templ.URL(rhymeURLLang(e.Lang, e.Headword)) }>Tìm vần cho “{ e.Headword }”</a>
		}
		if dict {
			<a class="btn" href={ templ.URL(dictURLLang(e.Lang, e.Headword)) }>Mở trong từ điển</a>
		}
	</p>
}

// PanelModel is a word opened from a result list.
type PanelModel struct {
	Entry  *rhymeindex.Entry
	Params app.RhymeParams // the search it was found by: what saving records
	Level  string          // the level it matched at, if known
	CSRF   string
	Next   string // where the no-JavaScript save comes back to
	Desk   bool   // opened from the writing desk: offer to insert it
}

// WordPanel fills the side panel (bottom sheet on phones).
templ WordPanel(m PanelModel) {
	<div class="panel-body" data-word={ m.Entry.Headword }>
		<button type="button" class="panel-close" data-close-panel aria-label="Đóng">×</button>
		@WordHeader(m.Entry, m.Level, false)
		<div class="panel-actions">
			if m.Desk {
				<button type="button" class="btn primary" data-insert={ m.Entry.Headword }>Chèn vào bài</button>
			}
			@SaveButton(m.Entry.ID, m.Params, m.CSRF, m.Next, "")
		</div>
		@Definition(m.Entry)
		@wordActions(m.Entry, true)
	</div>
}

// WordPage is a word on its own page. Opened from a result list without
// JavaScript, it also carries the save button (from is then non-nil).
templ WordPage(pc Page, e *rhymeindex.Entry, from *PanelModel, saved string) {
	@Layout(e.Headword+" — Playword", "dict", pc) {
		<article class="entry">
			if from != nil {
				@WordHeader(e, from.Level, true)
				<p class="actions">
					<a class="btn ghost" href={ templ.URL(SearchURL(from.Params, nil)) }>← Vần cho “{ from.Params.Text }”</a>
				</p>
				@SaveButton(e.ID, from.Params, from.CSRF, from.Next, saved)
			} else {
				@WordHeader(e, "", true)
			}
			@wordActions(e, false)
			@Definition(e)
		</article>
	}
}
