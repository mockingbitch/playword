package views

import "playword/internal/domain/account"

type BooksModel struct {
	Page  Page
	Books []account.Book
	Guest []account.GuestItem
	Error string
}

templ BooksPage(m BooksModel) {
	@Layout("Sổ vần — Playword", "books", m.Page) {
		<h1 class="page-title">Sổ vần</h1>
		if m.Error != "" {
			<p class="msg err" role="alert">{ m.Error }</p>
		}
		if m.Page.User == nil {
			<section class="card">
				<p>Đăng nhập để giữ sổ vần lâu dài. Khi chưa đăng nhập, các vần bạn lưu nằm trong sổ tạm ({ itoa(len(m.Guest)) }/20).</p>
				<p><a class="btn primary" href="/register?next=/books">Đăng ký</a> <a class="btn" href="/login?next=/books">Đăng nhập</a></p>
			</section>
			if len(m.Guest) > 0 {
				<section class="card">
					<h2>Sổ tạm</h2>
					<ul class="items">
						for _, g := range m.Guest {
							<li class="item"><span class="item-text">{ g.Text }</span>
								if g.MatchedFrom != "" {
									<span class="muted small">vần với “{ g.MatchedFrom }”</span>
								}
							</li>
						}
					</ul>
				</section>
			}
		} else {
			<form method="post" action="/books" class="card inline-form">
				@csrfField(m.Page)
				<input name="title" placeholder="Tên sổ mới, vd: Bài mới — verse 1" maxlength="120" required aria-label="Tên sổ"/>
				<button class="btn primary" type="submit">Tạo sổ</button>
			</form>
			if len(m.Books) == 0 {
				<p class="msg">Chưa có sổ nào. Tạo sổ rồi bấm ＋ cạnh kết quả tìm vần để lưu.</p>
			}
			<ul class="books">
				for _, b := range m.Books {
					<li>
						<a href={ templ.URL("/books/" + b.ID) }>
							<span class="book-title">{ b.Title }</span>
							<span class="muted small">{ itoa(b.ItemCount) } mục · cập nhật { b.UpdatedAt.Format("02/01/2006") }</span>
							if b.IsPublic {
								<span class="b">công khai</span>
							}
						</a>
					</li>
				}
			</ul>
		}
	}
}

type BookModel struct {
	Page  Page
	Book  *account.Book
	Items []account.Item
	Owner bool
	Error string
}

templ BookPage(m BookModel) {
	@Layout(m.Book.Title+" — Sổ vần", "books", m.Page) {
		<header class="book-head">
			<h1 class="page-title">{ m.Book.Title }</h1>
			if m.Book.Description != "" {
				<p class="muted">{ m.Book.Description }</p>
			}
			<p class="small">
				Tải về:
				<a href={ templ.URL("/books/" + m.Book.ID + "/export?format=txt") }>txt</a> ·
				<a href={ templ.URL("/books/" + m.Book.ID + "/export?format=md") }>md</a> ·
				<a href={ templ.URL("/books/" + m.Book.ID + "/export?format=json") }>json</a>
				if m.Book.IsPublic {
					· <span class="b">công khai — ai có link đều xem được</span>
				}
			</p>
		</header>
		if m.Error != "" {
			<p class="msg err" role="alert">{ m.Error }</p>
		}
		if len(m.Items) == 0 {
			<p class="msg">Sổ trống.</p>
		}
		<ol
			class={ "items", templ.KV("sortable", m.Owner) }
			id="items"
			data-order-url={ "/books/" + m.Book.ID + "/order" }
		>
			for _, it := range m.Items {
				@BookItem(m.Book.ID, it, m.Owner)
			}
		</ol>
		if m.Owner {
			<form method="post" action={ templ.URL("/books/" + m.Book.ID + "/items") } class="card inline-form">
				@csrfField(m.Page)
				<input name="text" placeholder="Thêm cụm của riêng bạn…" maxlength="1000" required aria-label="Cụm tự nhập"/>
				<button class="btn" type="submit">Thêm</button>
			</form>
			<details class="card">
				<summary>Sửa sổ</summary>
				<form method="post" action={ templ.URL("/books/" + m.Book.ID) } class="stack">
					@csrfField(m.Page)
					<label>Tên <input name="title" value={ m.Book.Title } maxlength="120" required/></label>
					<label>Mô tả <textarea name="description" maxlength="1000">{ m.Book.Description }</textarea></label>
					<label class="check"><input type="checkbox" name="public" value="true" checked?={ m.Book.IsPublic }/> Công khai (ai có link đều xem được)</label>
					<button class="btn primary" type="submit">Lưu</button>
				</form>
				<form method="post" action={ templ.URL("/books/" + m.Book.ID + "/delete") }>
					@csrfField(m.Page)
					<button class="btn danger" type="submit">Xoá sổ</button>
				</form>
			</details>
		}
	}
}

templ BookItem(bookID string, it account.Item, owner bool) {
	<li class="item" data-id={ i64(it.ID) }>
		if owner {
			<span class="grip" aria-hidden="true" title="Kéo để sắp xếp">⋮⋮</span>
		}
		<div class="item-body">
			if it.EntryID != 0 {
				<a class="item-text" href={ templ.URL(WordURLFor(it.Lang, it.Text)) }>{ it.Text }</a>
			} else {
				<span class="item-text">{ it.Text }</span>
			}
			if it.MatchedFrom != "" {
				<span class="muted small">vần với “{ it.MatchedFrom }”{ levelNote(it.Level) }</span>
			}
			if owner {
				<form class="note" hx-post={ "/books/" + bookID + "/items/" + i64(it.ID) + "/note" } hx-trigger="change" hx-swap="none">
					<input name="note" value={ it.Note } placeholder="ghi chú…" maxlength="1000" aria-label="Ghi chú"/>
				</form>
			} else if it.Note != "" {
				<p class="small">{ it.Note }</p>
			}
		</div>
		if owner {
			<button
				type="button"
				class="icon-btn"
				hx-post={ "/books/" + bookID + "/items/" + i64(it.ID) + "/delete" }
				hx-target="closest li"
				hx-swap="outerHTML"
				aria-label="Xoá"
				title="Xoá"
			>×</button>
		}
	</li>
}
