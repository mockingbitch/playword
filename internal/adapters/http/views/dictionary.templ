package views

import (
	"playword/internal/adapters/index/lookup"
	"playword/internal/domain/entry"
)

templ DictionaryPage(m DictModel) {
	@Layout(dictTitle(m.Query), "dict", m.Page) {
		<form class="search-form dict-form" action="/dictionary" method="get" role="search">
			if isEN(m.Lang) {
				<input type="hidden" name="lang" value="en"/>
			}
			<div class="qbox">
				<svg class="ico qico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg>
				<input
					id="dq"
					name="q"
					type="search"
					value={ m.Query }
					placeholder="Tra từ… gõ không dấu hay telex đều được"
					aria-label="Từ cần tra"
					autocomplete="off"
					autocapitalize="off"
					spellcheck="false"
					enterkeyhint="search"
					role="combobox"
					aria-controls="suggest"
					aria-expanded="false"
					hx-get="/dictionary/suggest"
					hx-include="closest form"
					hx-trigger="keyup changed delay:150ms, search"
					hx-target="#suggest"
					hx-swap="innerHTML"
					hx-sync="this:replace"
					autofocus
				/>
			</div>
			<div id="suggest" class="suggest" role="listbox" aria-label="Gợi ý"></div>
			<div class="toolbar">
				@langSwitch("/dictionary", m.Query, string(m.Lang))
			</div>
		</form>
		if m.Error != "" {
			<div class="empty"><p>{ m.Error }</p></div>
		}
		if m.Entry != nil {
			<article class="entry">
				@WordHeader(m.Entry, "", true)
				@wordActions(m.Entry, false)
				@Definition(m.Entry)
			</article>
		} else if m.Query != "" {
			<div class="empty">
				<p>Không có mục “{ m.Query }”.</p>
				<p class="actions">
					<a class="btn" href={ templ.URL(rhymeURLLang(m.Lang, m.Query)) }>Tìm vần cho “{ m.Query }”</a>
					<a class="btn" href="/slang/new">Đóng góp từ này</a>
				</p>
			</div>
			if len(m.Suggestions) > 0 {
				<h2 class="sub">Có phải bạn muốn tìm</h2>
				<div class="list">
					@Suggestions(m.Lang, m.Suggestions)
				</div>
			}
			if len(m.Meanings) > 0 {
				<h2 class="sub">Xuất hiện trong phần nghĩa</h2>
				<div class="list">
					for _, e := range m.Meanings {
						<a class="sg" href={ templ.URL(dictURLLang(e.Lang, e.Headword)) }>
							<span class="sg-word">{ e.Headword }</span>
							<span class="sg-gloss">{ firstSense(e).Gloss }</span>
						</a>
					}
				</div>
			}
		} else {
			<p class="muted small">Gõ không dấu hay Telex đều được: “tan”, “tanf” → tàn. Thiếu slang? <a href="/slang/new">Đóng góp một từ</a>.</p>
		}
	}
}

templ Suggestions(lang entry.Lang, list []lookup.Suggestion) {
	for _, s := range list {
		<a class="sg" role="option" href={ templ.URL(dictURLLang(lang, s.Entry.Word)) }>
			<span class="sg-word">
				if a, b := splitHL(s.Entry.Word, s.HL); a != "" {
					<mark>{ a }</mark>{ b }
				} else {
					{ b }
				}
			</span>
			<span class="sg-gloss">{ s.Entry.Gloss() }</span>
			if s.Fuzzy() {
				<span class="b">gần đúng</span>
			}
		</a>
	}
}
