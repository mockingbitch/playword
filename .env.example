# Copy to .env (git-ignored) and fill in. Read by `make` and `docker compose`.
# The server itself only reads the process environment.

# Google sign-in: Google Cloud Console → Credentials → OAuth client ID (Web application),
# authorized redirect URI = {PLAYWORD_PUBLIC_URL}/auth/google/callback
PLAYWORD_GOOGLE_CLIENT_ID=
PLAYWORD_GOOGLE_CLIENT_SECRET=
PLAYWORD_PUBLIC_URL=http://localhost:8020

# Admin API bearer token (at least 32 characters)
PLAYWORD_ADMIN_TOKEN=

# PLAYWORD_IP_SALT=dev-salt
# PLAYWORD_LOG_LEVEL=INFO
